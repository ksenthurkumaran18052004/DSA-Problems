class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int n= piles.length;

        int left=1; int right=0;
        for(int num:piles){
            right=Math.max(num,right);
        }
        int ans=right;
        while(left<=right){
            int mid=(left+right)/2;
            long th=func(piles,mid);
            if(th<=(long)h){
                ans=mid;
                right=mid-1;
            }
            else{
                left=mid+1;
            }
        }
        return ans;
    }

    public static long func(int[] nums, int i){
        long total_hours=0;
        for(int num:nums){
            total_hours+= (num+i-1)/i;
        }
        return total_hours;
    }
}
